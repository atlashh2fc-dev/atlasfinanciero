NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Dominio canónico usado por los correos de acceso en producción.
# En desarrollo puede omitirse: la aplicación usa el origen de la solicitud.
APP_URL=https://atlasfinanciero.vercel.app

# Sólo servidor. Permite a un Administrador invitar usuarios desde Atlas.
# Usa una Secret Key actual (sb_secret_...) o, sólo por compatibilidad, Service Role.
SUPABASE_SECRET_KEY=

# ChileCompra / Mercado Público. Sólo servidor: permite reemplazar el ticket
# documental público por el ticket propio solicitado en chilecompra.cl/api/.
CHILECOMPRA_API_TICKET=

# Vercel Cron lo incorpora como Bearer al ejecutar el radar diario de
# Mercado Público. La programación está en UTC (11:30 = 07:30 Chile en julio).
CRON_SECRET=

# PeopleWork. Estas variables son exclusivas del servidor: nunca usar el prefijo
# NEXT_PUBLIC_ ni incluir valores reales en Git. La URL, método de autenticación
# y endpoint se completan desde la documentación o soporte de PeopleWork.
PEOPLEWORK_API_BASE_URL=
PEOPLEWORK_API_KEY=
PEOPLEWORK_SECRET_KEY=
PEOPLEWORK_PAYROLL_COSTS_PATH=
PEOPLEWORK_AUTH_SCHEME=

# SII Factura Electrónica. Sólo servidor: certificado digital autorizado para el
# RUT de la empresa. Los valores deben ser PEM (con \n codificado si el gestor
# de secretos no permite saltos de línea). No publicar ni subir archivos PFX.
# Convertir el certificado fuera del repositorio y cargarlo como secreto.
# El mismo certificado autentica el WS de Aceptación/Reclamo y la descarga
# diaria del Registro de Compras y Ventas (RCV); no se requieren variables
# adicionales para el RCV.
SII_PRIVATE_KEY_PEM=
SII_CERTIFICATE_PEM=

# Correo tributario de facturación. Sólo servidor: Atlas conserva metadatos de
# trazabilidad y adjuntos financieros, nunca el cuerpo de los mensajes.
SII_IMAP_HOST=
SII_IMAP_PORT=993
SII_IMAP_USER=
SII_IMAP_PASSWORD=
